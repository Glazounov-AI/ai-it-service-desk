{
  "rules": [
    {
      "flag": "secret",
      "pattern": "-----BEGIN [^-\\n]*PRIVATE KEY-----[\\s\\S]*",
      "block": true
    },
    {
      "flag": "secret",
      "pattern": "\\b(?:sk-[A-Za-z0-9_-]{12,}|\\d{6,12}:[A-Za-z0-9_-]{20,})\\b",
      "block": false
    },
    {
      "flag": "secret",
      "pattern": "(?:пароль|password|api[_ -]?key|token|токен|код MFA|код подтверждения)\\s*(?:[:=]|\\s+это\\s+)\\s*[^\\s,;]+",
      "block": false
    },
    {
      "flag": "secret",
      "pattern": "(?:мой пароль|мой код MFA|мой код подтверждения)\\s+[^\\s,;]+",
      "block": false
    },
    {
      "flag": "bypass",
      "pattern": "(?:обойти|отключить|игнорируй).{0,80}(?:mfa|защит|инструкц|правил)",
      "block": true
    },
    {
      "flag": "secret_offer",
      "pattern": "(?:могу|хочу|давайте).{0,30}(?:прислать|сообщить|отправить).{0,30}(?:пароль|код|токен)",
      "block": true
    },
    {
      "flag": "secret_offer",
      "pattern": "(?:код\\s+(?:MFA|подтверждения)|пароль|токен).{0,80}(?:отправить|прислать|сообщить)\\s+(?:его\\s+)?(?:тебе|вам)",
      "block": true
    }
  ]
}
